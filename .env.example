# ==========================================
# Настройки WordPress (CMS)
# ==========================================
WP_URL=http://opticscopilot.local
WP_USER=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ==========================================
# Настройки LLM (OpenRouter)
# ==========================================
LLM_API_KEY=sk-or-v1-ваш_ключ_здесь
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_PRIMARY_MODEL=deepseek/deepseek-chat
LLM_FALLBACK_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
# Цены в USD за 1 млн токенов. Пусто — таблица по умолчанию в app/settings.py.
# LLM_PRICE_PER_MILLION={"deepseek/deepseek-chat":{"input":0.27,"output":1.10}}

# ==========================================
# Настройки Telegram-бота
# ==========================================
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_MANAGER_CHAT_ID=-1001234567890

# ==========================================
# Настройки приложения
# ==========================================
DATABASE_URL=sqlite:///./data/app.db
CHROMA_PERSIST_DIR=./data/chroma
PIPELINE_MODE=manual
# Как часто `python -m pipeline schedule` запускает полный прогон.
PIPELINE_INTERVAL_HOURS=6
ADMIN_PASSWORD=секретный_пароль_для_входа_в_streamlit
# Несколько адресов можно перечислить через запятую.
NEWS_SOURCE_URL=https://www.electronicsweekly.com/news/
PRODUCTS_SOURCE_URL=https://www.ryanoptics.com/Marine-Gyro-Stabilized-Camera-pl44267786.html
PDF_URLS=