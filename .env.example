# Скопируйте в .env и подставьте свои значения. Файл .env не коммитится.
# В Docker пути к базе, Chroma и журналу пайплайна переопределяются на /data
# и этот каталог общий для всех сервисов. Строки ниже нужны для локального запуска.

# ==========================================
# WordPress (куда публикуются карточки)
# ==========================================
# Адрес сайта без слэша на конце.
WP_URL=http://opticscopilot.local
# Пользователь WordPress с правами на запись постов.
WP_USER=admin
# Пароль приложения: Пользователи → Профиль → Пароли приложений.
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ==========================================
# LLM через OpenRouter
# ==========================================
LLM_API_KEY=sk-or-v1-ваш_ключ_здесь
LLM_BASE_URL=https://openrouter.ai/api/v1
# Модель перевода и ответов бота.
LLM_PRIMARY_MODEL=deepseek/deepseek-chat
# Запасная модель. Сейчас клиент её сам не переключает, имя нужно для учёта цены.
LLM_FALLBACK_MODEL=openai/gpt-4o-mini
# Модель эмбеддингов для индекса и поиска.
EMBEDDING_MODEL=openai/text-embedding-3-small
# Цены в USD за 1 млн токенов, JSON. Если строку убрать, берётся таблица из app/settings.py.
# LLM_PRICE_PER_MILLION={"deepseek/deepseek-chat":{"input":0.27,"output":1.10},"openai/text-embedding-3-small":{"input":0.02,"output":0}}

# ==========================================
# Telegram
# ==========================================
# Токен от @BotFather. Без него сервис telegram-bot будет перезапускаться.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Чат менеджера, куда бот пишет при эскалации. Для группы id обычно отрицательный.
TELEGRAM_MANAGER_CHAT_ID=-1001234567890

# ==========================================
# Приложение
# ==========================================
# Локальный SQLite. В контейнерах compose подставляет sqlite:////data/app.db.
DATABASE_URL=sqlite:///./data/app.db
# Каталог векторов Chroma. В контейнерах: /data/chroma.
CHROMA_PERSIST_DIR=./data/chroma
# Режим до первой смены в админке: manual (стоп на ревью) или auto (сразу в CMS).
# После переключения в админке решает запись в базе, а не эта строка.
PIPELINE_MODE=manual
# Как часто планировщик запускает полный прогон, в часах. Минимум 1.
PIPELINE_INTERVAL_HOURS=6
# Журнал прогонов. Принимается и PIPELINE_LOG, и PIPELINE_LOG_PATH.
# В контейнерах compose задаёт PIPELINE_LOG_PATH=/data/pipeline.log.
PIPELINE_LOG=./data/pipeline.log
# Пароль входа в Streamlit-админку.
ADMIN_PASSWORD=секретный_пароль_для_входа_в_streamlit

# ==========================================
# Источники. Несколько адресов — через запятую. Пусто = источник выключен.
# ==========================================
NEWS_SOURCE_URL=https://www.electronicsweekly.com/news/
PRODUCTS_SOURCE_URL=https://www.ryanoptics.com/Marine-Gyro-Stabilized-Camera-pl44267786.html
PDF_URLS=
